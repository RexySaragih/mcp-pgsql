{
  "name": "@rexymayderio/postgres-mcp",
  "version": "1.0.1",
  "description": "MCP server for connecting to PostgreSQL database",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "postgres-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "postgresql",
    "postgres",
    "database"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "pg": "^8.11.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pg": "^8.10.9",
    "typescript": "^5.5.3"
  }
}
